# Deterministic decisions, real browser actions. Set false to use the configured AI provider.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Choose openrouter when using an OpenRouter key. Website mode uses AI regardless of DEMO_MODE.
AI_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional Python 3 executable for the integrated runtime rules (standard library only).
PYTHON_EXECUTABLE=python3
