# The website defaults to the local OpenClaw Research agent.
# These API settings are optional legacy-adapter settings; faculty web tools use keyless Firecrawl.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3001

# Optional existing local OpenClaw gateway. For the isolated setup instead run
# npm run openclaw:setup, which writes these values into private .env.openclaw.
# Do not copy an empty token here; .env takes precedence over .env.openclaw.
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# OPENCLAW_AGENT_ID=research-matchmaker
