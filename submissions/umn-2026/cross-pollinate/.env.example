# The local Codex backend uses your existing `codex login` sign-in.
AGENT_BACKEND=codex
# Optional overrides; leave empty to use the Codex default model and auto-detected binary.
CODEX_MODEL=
CODEX_BIN=
# To use the OpenAI API instead, set AGENT_BACKEND=openai and supply your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
PORT=7860
