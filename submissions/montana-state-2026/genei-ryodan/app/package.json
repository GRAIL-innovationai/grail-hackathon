{
  "name": "mathub-app",
  "version": "1.0.0",
  "private": true,
  "description": "Mathub for iOS and Android: the study hub, offline, with classes you create from your own syllabus.",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "node scripts/build-www.js && cap sync",
    "sync:ios": "node scripts/build-www.js && cap sync ios",
    "sync:android": "node scripts/build-www.js && cap sync android",
    "open": "cap open ios",
    "open:android": "cap open android",
    "art": "node scripts/make-art.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@revenuecat/purchases-capacitor": "13.7.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "mathjax": "3.2.2",
    "pyodide": "0.28.3"
  }
}
